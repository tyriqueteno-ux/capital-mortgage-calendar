# Copy to .env.local for local testing. On Vercel, add these under Settings → Environment Variables.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Any long random string. Generate one at https://generate-secret.vercel.app/32
NEXTAUTH_SECRET=
# Your site's address, e.g. https://capital-mortgage-calendar.vercel.app
NEXTAUTH_URL=http://localhost:3000
